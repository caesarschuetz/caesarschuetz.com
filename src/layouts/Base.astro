---
import '../styles/global.css';

const { title, description } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600&family=JetBrains+Mono:wght@400&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <nav class="site">
    <div class="wrap">
      <a class="home" href="/">Caesar Schütz</a>
      <a href="/building/">Building</a>
      <a href="/writing/">Writing</a>
      <a href="mailto:info@caesarschuetz.com">Contact</a>
    </div>
  </nav>

  <main class="wrap">
    <slot />
  </main>

  <footer class="site">
    <div class="wrap">
      <span>© {year} Caesar Schütz</span>
      <a href="https://www.linkedin.com/in/caesar-schuetz">LinkedIn</a>
      <a href="https://www.instagram.com/caesarschuetz/">Instagram</a>
      <a href="https://caesarschuetz.substack.com">Substack</a>
      <a href="https://x.com/caesar_schuetz">X</a>
      <a href="https://github.com/caesarschuetz">GitHub</a>
      <a href="mailto:info@caesarschuetz.com">info@caesarschuetz.com</a>
      <a href="/impressum/">Impressum</a>
    </div>
  </footer>
</body>
</html>
