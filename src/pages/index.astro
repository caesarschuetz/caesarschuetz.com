---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short' });
---

<Base
  title="Caesar Schütz"
  description="Tech Founder and Wealth Manager from Munich. I build products and advise people on their money."
>
  <section class="intro">
    <img class="portrait" src="/portrait.jpg" srcset="/portrait.jpg 1x, /portrait@2x.jpg 2x" width="480" height="584" alt="Caesar Schütz" />
    <h1>Tech Founder and Wealth Manager from Munich.</h1>
    <p>Six years of sitting across the table from people and their money. Somewhere along the way I started building software on the side, and the side kept growing.</p>
    <p class="muted">This site is where I keep track of what I build and what I learn doing it. Currently working on something new, not yet public.</p>
  </section>

  <section id="work">
    <h2>What I do</h2>
    <div class="item">
      <h3>Advising</h3>
      <p>Self-employed advisor for private clients at tecis, part of Swiss Life Group. Started there as a trainee in 2020, ran a team of 25 at 23, now my own book of clients.</p>
    </div>
    <div class="item">
      <h3>Building</h3>
      <p>Apps and small companies, mostly solo, mostly bootstrapped. The full list, from the first one in 2017 to the latest, is on the <a href="/building/">building page</a>.</p>
    </div>
    <div class="item">
      <h3>Studying</h3>
      <p>Information Systems at TUM. Half computer science, the rest economics and information systems. Finishing 2027.</p>
    </div>
  </section>

  <section id="writing">
    <h2>Writing</h2>
    {posts.length === 0 ? (
      <p class="muted">Nothing published yet.</p>
    ) : (
      <ul class="posts">
        {posts.map((p) => (
          <li><time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time><a href={`/writing/${p.id}/`}>{p.data.title}</a></li>
        ))}
      </ul>
    )}
    {posts.length > 0 && <p style="margin-top: 16px;"><a href="/writing/">All writing</a></p>}
    <p class="muted" style="margin-top: 16px;">New posts also go out by email via <a href="https://caesarschuetz.substack.com">Substack</a>.</p>
  </section>

  <section id="elsewhere">
    <h2>Elsewhere</h2>
    <p>
      <a href="https://www.linkedin.com/in/caesar-schuetz">LinkedIn</a>,
      <a href="https://www.instagram.com/caesarschuetz/">Instagram</a>,
      <a href="https://caesarschuetz.substack.com">Substack</a>,
      <a href="https://x.com/caesar_schuetz">X</a>,
      <a href="https://www.youtube.com/channel/UCYcsVUEpExvM7hAT2_OWIhQ">YouTube</a>,
      <a href="https://github.com/caesarschuetz">GitHub</a>.
      Email: <a href="mailto:info@caesarschuetz.com">info@caesarschuetz.com</a>
    </p>
  </section>
</Base>
